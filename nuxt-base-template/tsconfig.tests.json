{
  // CLI type-check gate for the test suites (tests/unit + tests/e2e).
  //
  // `nuxt build` and `oxlint app/` never look at tests/, and vitest / Playwright
  // transpile without type-checking — so type errors in specs (wrong helper
  // arity, missing imports, stale API shapes) land unnoticed. `pnpm run
  // typecheck:tests` (wired into `check` and CI) runs vue-tsc over this config to
  // close that gap.
  //
  // Shares every common knob (types, strictness relaxations, path aliases,
  // ES2022 target) with the editor config in tests/tsconfig.json by extending
  // it — so the gate and the IDE never diverge. This file adds only what the
  // CLI run needs on top: the root-relative file scope (tests/tsconfig.json's
  // own include is relative to tests/) and an explicit noEmit — it is a pure
  // gate.
  //
  // The extends chain (tests/tsconfig.json → tsconfig.json → .nuxt/tsconfig.json)
  // makes specs resolve the same way vitest does at runtime (`~` → app/,
  // auto-imports via .nuxt ambient types). It needs a prior `nuxt prepare`; the
  // typecheck:tests script runs that first.
  //
  // Tool choice — `vue-tsc`, not plain `tsc`: specs may import `.vue` components
  // (`tests/unit/components/tus-file-upload.test.ts` mounts one), and plain
  // `tsc` cannot resolve `.vue` at all. The starter ran on `tsc` while its specs
  // imported only `.ts`; the switch cost nothing but the word, since `vue-tsc`
  // is already a devDependency (`pnpm run typecheck`, the APP-source half of the
  // gate, runs on it). The pinned pair is vue-tsc 3.3.13 on TypeScript 6.0.3 —
  // verified working; keep them in step when bumping either.
  "extends": "./tests/tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [".nuxt/nuxt.d.ts", "tests/**/*.ts"]
}
