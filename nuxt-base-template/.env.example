# Local URLs — defaults for `nuxt dev` without `lt dev up`.
# When started via `lt dev up`, these are overridden to
# `https://<slug>.localhost` / `https://api.<slug>.localhost`.
NUXT_PUBLIC_SITE_URL=http://localhost:3001
# Deployment environment. Dual role:
#  - BUILD TIME: `local`/`development` bake the ./docs layer + landing-page dev
#    card + bug.lt reporter into the bundle (see nuxt.config.ts `devBuild`).
#    Unset resolves to `production` -> those dev surfaces are never built.
#  - RUNTIME: relabels a running container (e.g. shown under /app/admin/system).
#    A runtime value can hide a built dev surface but never conjure one that was
#    not baked in.
NUXT_PUBLIC_APP_ENV=local
NODE_ENV=development
# Build identity, surfaced under /app/admin/system to detect a stale container.
# Normally injected at container runtime / by CI (the Dockerfile maps the
# APP_VERSION_COMMIT build-arg to it); defaults to `unknown` for local dev.
NUXT_PUBLIC_APP_COMMIT=unknown
NUXT_API_URL=http://localhost:3000
NUXT_PUBLIC_API_URL=http://localhost:3000
NUXT_PUBLIC_WEB_PUSH_KEY=
# Local storage namespace prefix (prevents key collisions between projects on localhost).
# `lt dev up` overrides this with the project slug.
NUXT_PUBLIC_STORAGE_PREFIX=my-project-local

# ---------------------------------------------------------------------------
# Local Development API Proxy
# ---------------------------------------------------------------------------
# Enables the Vite dev proxy to forward /api/* requests to the backend
# (localhost:3000). The proxy strips the /api/ prefix before forwarding,
# so the backend receives the original path (e.g., /iam/sign-in).
#
# WHY: In classic mode (without `lt dev`), frontend (localhost:3001) and
# backend (localhost:3000) are on different ports. Browsers enforce
# same-origin policy for cookies, which breaks session-based authentication.
# The proxy makes all requests appear same-origin.
#
# WHEN TO LEAVE THIS `true`:
# - You run `pnpm dev` without Caddy (classic localhost:3000 + 3001 mode)
#
# WHEN TO SET TO `false` (or rely on `lt dev up`'s automatic override):
# - You run `lt dev up` — Caddy serves both subdomains under HTTPS with
#   shared cookie domain `.<slug>.localhost`, and the vite-proxy is no
#   longer needed.
# - You target a deployed stage (develop, test, preview, production) —
#   those always call the backend directly via NUXT_PUBLIC_API_URL.
#
# Nuxt auto-maps this to runtimeConfig.public.apiProxy.
# `lt dev up` always exports NUXT_PUBLIC_API_PROXY=false.
NUXT_PUBLIC_API_PROXY=true

NUXT_PLAUSIBLE_API_URL=

NUXT_LINEAR_API_KEY=
NUXT_LINEAR_TEAM_NAME=
NUXT_LINEAR_PROJECT_NAME=

# ---------------------------------------------------------------------------
# Build / output directories
#
# Per-command, not normally set in .env — listed here because they are env vars
# the template reads, and a `git status` full of unfamiliar dot-directories is
# otherwise hard to explain. Commented out on purpose: setting them globally
# would defeat the isolation they exist to provide.
# ---------------------------------------------------------------------------
# NUXT_BUILD_DIR   — Nuxt build dir, default `.nuxt`. `pnpm run check` pins
#                    `.nuxt-check`; `lt dev test` pins `.nuxt-test`. Keeps a gate
#                    run from corrupting the `.nuxt/` a parked `nuxt dev` reads.
# NITRO_OUTPUT_DIR — Nitro output dir, default `.output`. `lt dev test` pins
#                    `.output-test`. NOT a Nitro feature despite the prefix —
#                    nuxt.config.ts opens this lever.
# E2E_BUILT_SERVER — `true` makes Playwright start the BUILT server
#                    (`node $NITRO_OUTPUT_DIR/server/index.mjs`) instead of
#                    `nuxt dev`, skipping the Vite cold start. Requires a prior
#                    `pnpm run build`. Set by lt-monorepo's CI, not by this repo.
