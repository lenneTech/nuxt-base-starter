{
  "name": "nuxt-base-template",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "node": "./tslib.es6.mjs"
      }
    }
  },
  "scripts": {
    "c": "pnpm run check",
    "check": "node scripts/check.mjs",
    "check:raw": "pnpm install --frozen-lockfile && pnpm audit && pnpm run format:check && pnpm run lint && pnpm test && pnpm run build && bash scripts/check-server-start.sh",
    "check:fix": "pnpm install && pnpm audit --fix && pnpm run format && pnpm run lint:fix && pnpm test && pnpm run build && bash scripts/check-server-start.sh",
    "check:naf": "pnpm install && pnpm run format && pnpm run lint:fix && pnpm test && pnpm run build && bash scripts/check-server-start.sh",
    "cf": "pnpm run check:fix",
    "cnaf": "pnpm run check:naf",
    "init": "pnpm install",
    "reinit": "npx rimraf pnpm-lock.yaml && npx nuxt cleanup && npx rimraf node_modules && pnpm install",
    "clean": "npx rimraf .nuxt .output",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "build:develop": "npx cross-env NODE_ENV=development nuxt build",
    "build:test": "npx cross-env NODE_ENV=test nuxt build",
    "build:prod": "npx cross-env NODE_ENV=production nuxt build",
    "start": "nuxt dev",
    "start:develop": "node .output/server/index.mjs",
    "start:test": "node .output/server/index.mjs",
    "start:prod": "node .output/server/index.mjs",
    "start:tunnel": "nuxt dev --tunnel",
    "start:extern": "npx cross-env HOST=0.0.0.0 nuxt dev",
    "generate": "nuxt generate",
    "generate-types": "openapi-ts",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "simple-git-hooks",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "pnpm run test:unit && pnpm run test:e2e",
    "lint": "oxlint app/",
    "lint:fix": "oxlint --fix --fix-suggestions app/",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "fix": "pnpm run lint:fix && pnpm run format"
  },
  "dependencies": {
    "@better-auth/passkey": "1.6.23",
    "@lenne.tech/bug.lt": "1.6.9",
    "@lenne.tech/nuxt-extensions": "1.10.3",
    "@nuxt/image": "2.0.0",
    "@nuxt/ui": "4.10.0",
    "@pinia/nuxt": "1.0.1",
    "@vueuse/nuxt": "14.3.0",
    "better-auth": "1.6.23",
    "pinia": "4.0.2",
    "qrcode": "1.5.4",
    "tus-js-client": "4.3.1",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@iconify-json/lucide": "1.2.117",
    "@nuxt/test-utils": "4.0.3",
    "@nuxtjs/plausible": "3.0.2",
    "@nuxtjs/seo": "5.3.2",
    "@playwright/test": "1.61.1",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.1.1",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-vue": "6.0.8",
    "happy-dom": "20.10.6",
    "lint-staged": "17.0.8",
    "mongodb": "7.5.0",
    "nuxt": "4.4.8",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "rimraf": "6.1.3",
    "simple-git-hooks": "2.13.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "vue": "3.5.40"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "pre-push": "pnpm run test:unit"
  },
  "lint-staged": {
    "app/**/*.{ts,vue}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "tests/**/*.ts": [
      "oxlint --fix"
    ]
  },
  "engines": {
    "node": ">=22",
    "pnpm": "^11.0.0"
  },
  "packageManager": "pnpm@11.14.0+sha512.66c1ac4c7d4762d6d7dde44c7f3e5a73591ed0a0806e751d4ed32d4f004f25b2285a906b1fd8a9e3e621df3b4e2858bf88e50e0cf626bedbe977fe434a5caf85"
}
