{
  "name": "nuxt-base-template",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "node": "./tslib.es6.mjs"
      }
    }
  },
  "scripts": {
    "c": "pnpm run check",
    "check": "node scripts/check.mjs",
    "check:raw": "cross-env NUXT_BUILD_DIR=.nuxt-check pnpm install --frozen-lockfile && cross-env NUXT_BUILD_DIR=.nuxt-check pnpm audit && pnpm run format:check && pnpm run lint && pnpm test && pnpm run build:check && pnpm run typecheck && pnpm run typecheck:tests && bash scripts/check-server-start.sh",
    "check:fix": "cross-env NUXT_BUILD_DIR=.nuxt-check pnpm install && cross-env NUXT_BUILD_DIR=.nuxt-check pnpm audit --fix && pnpm run format && pnpm run lint:fix && pnpm test && pnpm run build:check && pnpm run typecheck && pnpm run typecheck:tests && bash scripts/check-server-start.sh",
    "check:naf": "cross-env NUXT_BUILD_DIR=.nuxt-check pnpm install && pnpm run format && pnpm run lint:fix && pnpm test && pnpm run build:check && pnpm run typecheck && pnpm run typecheck:tests && bash scripts/check-server-start.sh",
    "cf": "pnpm run check:fix",
    "cnaf": "pnpm run check:naf",
    "init": "pnpm install",
    "reinit": "npx rimraf pnpm-lock.yaml && npx nuxt cleanup && npx rimraf .nuxt-check .nuxt-test .output .output-test node_modules && pnpm install",
    "clean": "npx rimraf .nuxt .nuxt-check .nuxt-test .output .output-test",
    "dev": "nuxt dev",
    "prepare:ide": "nuxt prepare",
    "build": "nuxt build",
    "build:check": "cross-env NUXT_BUILD_DIR=.nuxt-check nuxt build",
    "build:develop": "cross-env NODE_ENV=development nuxt build",
    "build:test": "cross-env NODE_ENV=test nuxt build",
    "build:prod": "cross-env NODE_ENV=production nuxt build",
    "start": "nuxt dev",
    "start:develop": "node .output/server/index.mjs",
    "start:test": "node .output/server/index.mjs",
    "start:prod": "node .output/server/index.mjs",
    "start:tunnel": "nuxt dev --tunnel",
    "start:extern": "cross-env HOST=0.0.0.0 nuxt dev",
    "generate": "nuxt generate",
    "generate-types": "node scripts/generate-types.mjs",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "simple-git-hooks",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "pnpm run test:unit && pnpm run test:e2e",
    "typecheck": "cross-env NUXT_BUILD_DIR=.nuxt-check nuxt typecheck",
    "typecheck:tests": "cross-env NUXT_BUILD_DIR=.nuxt-check nuxt prepare && tsc --noEmit -p tsconfig.tests.check.json && tsc --noEmit -p .nuxt-check/tsconfig.server.json",
    "lint": "oxlint app/ scripts/ server/ tests/",
    "lint:fix": "oxlint --fix --fix-suggestions app/ scripts/ server/",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "fix": "pnpm run lint:fix && pnpm run format"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.1",
    "@lenne.tech/bug.lt": "1.6.9",
    "@lenne.tech/nuxt-extensions": "1.16.0",
    "@nuxt/image": "2.1.0",
    "@nuxt/ui": "4.11.0",
    "@pinia/nuxt": "1.0.2",
    "@vueuse/nuxt": "14.4.0",
    "better-auth": "1.7.1",
    "pinia": "4.0.3",
    "qrcode": "1.5.4",
    "tus-js-client": "4.3.1",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@iconify-json/lucide": "1.2.125",
    "@nuxt/test-utils": "4.1.0",
    "@nuxtjs/plausible": "4.0.0",
    "@nuxtjs/seo": "5.3.14",
    "@playwright/test": "1.62.1",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-vue": "6.0.8",
    "cross-env": "10.1.0",
    "happy-dom": "20.11.6",
    "lint-staged": "17.3.0",
    "mongodb": "7.5.0",
    "nuxt": "4.5.2",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "rimraf": "6.1.3",
    "simple-git-hooks": "2.13.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "vue": "3.5.41",
    "vue-tsc": "3.3.11"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "pre-push": "pnpm run test:unit"
  },
  "lint-staged": {
    "app/**/*.{ts,vue}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "tests/**/*.ts": [
      "oxlint --fix"
    ],
    "scripts/**/*.mjs": [
      "oxlint --fix",
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=22",
    "pnpm": "^11.0.0"
  },
  "packageManager": "pnpm@11.14.0+sha512.66c1ac4c7d4762d6d7dde44c7f3e5a73591ed0a0806e751d4ed32d4f004f25b2285a906b1fd8a9e3e621df3b4e2858bf88e50e0cf626bedbe977fe434a5caf85"
}
